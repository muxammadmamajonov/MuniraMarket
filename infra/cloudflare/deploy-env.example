# Deploy-time variables for ONE environment (production; staging only if one is ever created).
# Production is pinned to muniramarket.uz / admin.muniramarket.uz and bot id 9038491407. Copy to a git-ignored file
# (e.g. infra/cloudflare/.env.staging, ignored by the root .gitignore), fill in, then:
#   set -a; . infra/cloudflare/.env.staging; set +a
#   node infra/cloudflare/scripts/validate-deploy-env.mts --mode staging
# None of these are secrets; secrets are Worker / Neon Function secrets (README.md). Placeholders only below.

MM_WEB_HOSTNAME=shop.staging.example.test
MM_ADMIN_HOSTNAME=admin.staging.example.test
MM_API_HOSTNAME=api.staging.example.test
# Also the Function's TELEGRAM_BOT_ID / TELEGRAM_OIDC_CLIENT_ID (neon.ts).
MM_TELEGRAM_BOT_ID=0000000000
# Also the Function's CSRF_TRUSTED_ORIGINS (neon.ts).
MM_CSRF_TRUSTED_ORIGINS=https://shop.staging.example.test,https://admin.staging.example.test

# STAGING ONLY. The host (no scheme) of the Core API Function the staging gateway's secret
# CORE_API_FUNCTION_ORIGIN points at, and of the production one. The validator refuses a staging
# deploy where they are equal. Not secrets; look them up with `neon functions get coreapi`.
MM_CORE_API_FUNCTION_HOST=
MM_PRODUCTION_FUNCTION_HOST=

# Release label stamped on every Core API log line (the Function's APP_RELEASE). Required in production.
APP_RELEASE=
