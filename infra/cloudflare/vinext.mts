/**
 * Shared pieces of the storefront and admin Cloudflare Workers builds (vinext + the Cloudflare
 * Vite plugin). Only `vite.config.ts` and `cloudflare.config.ts` import this; `next dev`,
 * `next build` and the unit tests never see it.
 */

import { realpathSync } from 'node:fs';
import type { Plugin } from 'vite';
import type { DeploymentTarget } from './environments.mts';

/**
 * Swaps `src/lib/api/upstream-fetch.ts` (global `fetch` to `API_INTERNAL_URL`, used by Next.js
 * and tests) for `worker/upstream-fetch.ts` (the `CORE_API` service binding) in the Workers
 * build, whatever specifier imported it.
 */
export function coreApiBindingPlugin(appDir: string): Plugin {
  // Compare real paths: Vite resolves through symlinks, a checkout path may contain one.
  const original = realpathSync(`${appDir}/src/lib/api/upstream-fetch.ts`);
  const replacement = realpathSync(`${appDir}/worker/upstream-fetch.ts`);
  return {
    name: 'muniramarket:core-api-binding',
    enforce: 'pre',
    async resolveId(source, importer, options) {
      if (!source.includes('upstream-fetch') || importer === replacement) return null;
      const resolved = await this.resolve(source, importer, { ...options, skipSelf: true });
      const id = resolved?.id.split('?')[0];
      return id !== undefined && realpathSync(id) === original ? replacement : null;
    },
  };
}

/** Workers Logs and Traces, with query strings redacted (search terms, filters). */
export function observability(target: DeploymentTarget) {
  return {
    enabled: true,
    redactQueryString: true,
    logs: { enabled: true, headSamplingRate: 1, invocationLogs: true },
    traces: { enabled: true, headSamplingRate: target.production ? 0.1 : 1 },
  };
}

/** Assets handling generated by `vinext init`: every request runs the Worker except hashed files. */
export function vinextAssets() {
  return {
    htmlHandling: 'none' as const,
    notFoundHandling: 'none' as const,
    runWorkerFirst: ['/*', '!/_next/static/*', '!/*/_next/static/*'],
  };
}

/** Custom domain from a deploy-time variable (never committed); none when unset or local. */
export function domainsFrom(target: DeploymentTarget, variable: string): string[] {
  const hostname = process.env[variable]?.trim();
  return target.deployed && hostname ? [hostname] : [];
}

/** Base URL the app code builds Core API URLs with. Deployed: a placeholder host, because the
 * request goes through the service binding and never resolves it. Locally: the developer's API. */
export function apiInternalUrl(target: DeploymentTarget): string {
  if (target.deployed) return 'https://core-api.internal';
  return process.env['API_INTERNAL_URL']?.trim() || 'http://localhost:8000';
}
