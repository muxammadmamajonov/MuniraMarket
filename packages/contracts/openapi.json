      "LoginWidgetRequest": {
        "additionalProperties": false,
        "description": "Fields of the Telegram Login Widget callback, passed through unchanged.\n\nUnknown fields are rejected: they would otherwise be silently included in (or excluded from)\nthe signed data-check-string.",
        "properties": {
          "auth_date": {
            "exclusiveMinimum": 0.0,
            "title": "Auth Date",
            "type": "integer"
          },
          "first_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "First Name",
            "type": "string"
          },
          "hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Hash",
            "type": "string"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "last_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "photo_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "username": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "required": [
          "id",
          "first_name",
          "auth_date",
          "hash"
        ],
        "title": "LoginWidgetRequest",
        "type": "object"
      },
