          "product_id": {
            "format": "uuid",
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "AddCartItemRequest",
        "type": "object"
      },
      "ApiErrorBody": {
        "properties": {
          "available_quantity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Quantity"
          },
          "code": {
            "enum": [
              "bad_request",
              "unauthorized",
              "forbidden",
              "not_found",
              "method_not_allowed",
              "conflict",
              "payload_too_large",
              "unsupported_media_type",
              "validation_error",
              "rate_limited",
              "internal_error",
              "service_unavailable",
              "invalid_telegram_auth",
              "session_required",
              "csrf_failed",
              "account_blocked",
              "feature_disabled",
              "category_not_found",
              "product_not_found",
              "product_inactive",
              "insufficient_stock",
              "cart_limit_reached",
              "cart_item_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorBody",
        "type": "object"
      },
      "AuthConfigResponse": {
