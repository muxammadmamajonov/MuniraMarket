    "/api/v1/internal/telegram/session": {
      "post": {
        "description": "Upsert the user the bot is acting for. The body id must equal the signed actor.",
        "operationId": "create_session_api_v1_internal_telegram_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "Body of ``POST /internal/telegram/session`` (sent by the signed Serverless caller).",
                "properties": {
                  "first_name": {
                    "maxLength": 255,
                    "minLength": 1,
                    "title": "First Name",
                    "type": "string"
                  },
                  "language_code": {
                    "anyOf": [
                      {
                        "maxLength": 16,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Language Code"
                  },
                  "last_name": {
                    "anyOf": [
                      {
                        "maxLength": 255,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Last Name"
                  },
                  "telegram_user_id": {
                    "exclusiveMinimum": 0.0,
                    "title": "Telegram User Id",
                    "type": "integer"
                  },
                  "username": {
                    "anyOf": [
                      {
                        "maxLength": 64,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Username"
                  }
                },
                "required": [
                  "telegram_user_id",
                  "first_name"
                ],
                "title": "TelegramSessionRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Session",
        "tags": [
          "internal"
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "description": "Active products in active categories, with stable pagination.",
        "operationId": "list_products_api_v1_products_get",
        "parameters": [
          {
            "description": "Category slug; includes all active descendant categories.",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category slug; includes all active descendant categories.",
              "title": "Category"
            }
          },
          {
            "description": "Case-insensitive substring of name (uz/ru) or SKU; 2-100 characters after trimming. `%`, `_` and `\\` are matched literally.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 2,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive substring of name (uz/ru) or SKU; 2-100 characters after trimming. `%`, `_` and `\\` are matched literally.",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProductSort",
              "default": "newest"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 1000000,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 48,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "List Products",
        "tags": [
          "catalog"
        ]
      }
    },
