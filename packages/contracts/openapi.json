      "SessionResponse": {
        "description": "Returned by every login and by ``GET /auth/session``.\n\n``csrf_token`` must be kept in memory by the client and sent as ``X-CSRF-Token`` on every\nstate-changing request. The session token itself is only ever in the HTTP-only cookie.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          }
        },
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
