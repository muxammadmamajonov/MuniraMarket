# Server-side configuration of the admin. Placeholders only: never commit a real `.env`.
# Nothing here is shipped to the browser: it reaches the Core API through its own same-origin
# proxy at /api/v1/* (only `auth/**` and `admin/**` are forwarded).

# Where this server reaches the Core API (no trailing slash).
API_INTERNAL_URL=http://localhost:8000

# Optional. Name of the request header in which the trusted edge in front of this server (CDN or
# load balancer) puts the real client IP, e.g. x-real-ip. The edge must overwrite it on every
# request; it is forwarded to the Core API as X-Forwarded-For, and the Core API must trust only this
# server's address (FORWARDED_ALLOW_IPS). Leave empty to forward no client IP (the Core API then
# rate-limits everyone behind this server as one address).
CLIENT_IP_HEADER=
