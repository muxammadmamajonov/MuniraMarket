{
  "name": "@muniramarket/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && pnpm typecheck:worker",
    "test": "vitest run",
    "build": "next build",
    "typecheck:worker": "cf workers types --mode staging && tsc --noEmit -p tsconfig.worker.json",
    "dev:worker": "vite dev --port 3101",
    "build:worker": "vite build --mode staging && node ../../infra/cloudflare/scripts/assert-core-api-binding.mts",
    "build:worker:production": "vite build --mode production && node ../../infra/cloudflare/scripts/assert-core-api-binding.mts",
    "preview:worker": "vite build --mode development && vite preview --port 3101"
  },
  "dependencies": {
    "@muniramarket/contracts": "workspace:*",
    "@muniramarket/ui": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.27",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vinext": "1.4.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
