# Runtime configuration for the web server. None of these are shipped to the browser.
#
# Core API base URL as reachable from the web server. Browsers never call the API directly: they
# use the same-origin proxy at /api/v1/*, which forwards to this URL. Read at runtime, so one
# build works for every environment.
API_INTERNAL_URL=http://localhost:8000

# Optional. Request header in which the trusted edge (load balancer / CDN) puts the real client IP,
# e.g. x-real-ip. The edge MUST overwrite it on every request. The proxy forwards it to Core API as
# X-Forwarded-For; a browser-sent X-Forwarded-For is never forwarded. Leave unset when there is no
# such edge (Core API then rate-limits all browsers as one client - safe, but coarse).
# CLIENT_IP_HEADER=x-real-ip

# Optional. Two Yandex keys for the delivery-address picker: the JavaScript API key loads the map,
# while the Geocoder API key reverse-geocodes a confirmed pin to a district. Both reach the browser,
# so restrict each by HTTP Referer to the storefront domain in Yandex. Never commit real keys.
# Without the JavaScript key, the picker shows "map unavailable". Without the Geocoder key, the
# map stays usable but the customer must select their district from the list.
YANDEX_MAPS_JAVASCRIPT_API_KEY=
YANDEX_MAPS_GEOCODER_API_KEY=

# Optional. Public bot username (without @), e.g. MuniraMarketBot. Used only to build
# https://t.me/<bot>?start=phone links so browser visitors can verify their phone in the bot.
# Not a secret. Inside the Mini App the phone is shared with Telegram's own consent popup.
TELEGRAM_BOT_USERNAME=
