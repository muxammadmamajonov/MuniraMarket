# Runtime configuration for the web server. None of these are shipped to the browser.
#
# Core API base URL as reachable from the web server. Browsers never call the API directly: they
# use the same-origin proxy at /api/v1/*, which forwards to this URL. Read at runtime, so one
# build works for every environment.
API_INTERNAL_URL=http://localhost:8000

# Optional. Request header in which the trusted edge (load balancer / CDN) puts the real client IP,
# e.g. x-real-ip. The edge MUST overwrite it on every request. The proxy forwards it to Core API as
# X-Forwarded-For; a browser-sent X-Forwarded-For is never forwarded. Leave unset when there is no
# such edge (Core API then rate-limits all browsers as one client - safe, but coarse).
# CLIENT_IP_HEADER=x-real-ip

# Optional. Yandex Maps JavaScript API key (a UUID from the Yandex developer console) for the map
# step of the delivery-address picker. Unlike the settings above it does reach the browser (the
# API is loaded with the key in its URL), so restrict it by HTTP Referer to the shop's domains in
# the Yandex console. Never commit a real key. Left empty, the picker shows its "map unavailable"
# state, nothing is loaded from Yandex and the CSP does not allow Yandex hosts.
YANDEX_MAPS_API_KEY=
