{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // The Cron Trigger reuses the Telegram service's plain-JS request signer (JSDoc-typed,
    // `// @ts-check`) from ../telegram/tgcloud/lib/coreApi.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "cloudflare.config.ts", ".cloudflare/types/**/*.d.ts"]
}
