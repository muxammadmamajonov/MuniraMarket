{
  "name": "@muniramarket/core-api-function",
  "private": true,
  "type": "module",
  "description": "MuniraMarket Core API as a Neon Function (slug: coreapi). Reached only through the Cloudflare API gateway.",
  "scripts": {
    "dev": "node scripts/build.mjs --dev && node --enable-source-maps dist/dev-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@neon/functions": "0.11.0",
    "hono": "4.13.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
