# Copy to .env for local development. .env is git-ignored; never commit real values.
# Every value below is a placeholder.

# Required (no default): development | test | staging | production. API docs are served only
# for development and test.
APP_ENV=development

# Must use the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://muniramarket:change-me-local-only@localhost:5432/muniramarket
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed browser origins. '*' is always rejected; staging and
# production require https:// origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# key_id:secret[,key_id:secret] - each secret at least 32 bytes; key ids match [A-Za-z0-9_-]{1,32}.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_AUTH_KEYS=local:replace-with-at-least-32-random-bytes-xxxxxxxx

# Numeric id of the bot (the part of its token before the colon). Required (> 0) outside development.
TELEGRAM_BOT_ID=0
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# production | test - selects which Telegram Ed25519 public key signs initData.
TELEGRAM_ENVIRONMENT=production
# Optional. Leave unset to verify initData with Telegram's Ed25519 public key (recommended: the
# bot token never reaches this service). Setting it switches to HMAC verification.
# TELEGRAM_BOT_TOKEN=

# --- Browser sessions (architecture/0007-browser-sessions-csrf.md) ---
# true (default) => cookie "__Host-mm_session" with Secure. false is only accepted when APP_ENV is
# development or test (plain-HTTP localhost); the cookie is then "mm_session".
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_ROTATE_AFTER_SECONDS=86400
# 0..300. A rotated-away token keeps resolving to its successor this long, so requests the
# browser sent in parallel with the old cookie do not fail. 0 disables the grace period.
SESSION_ROTATION_GRACE_SECONDS=60
# Origins allowed to send POST/PUT/PATCH/DELETE (CSRF Origin check), comma-separated
# scheme://host[:port]. '*' is rejected; staging and production require https://.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Telegram Login Widget for the website (off by default) ---
# Enabling it requires TELEGRAM_BOT_TOKEN (which also switches initData to HMAC verification) and
# the bot's username.
TELEGRAM_LOGIN_WIDGET_ENABLED=false
# TELEGRAM_BOT_USERNAME=
# How old a widget payload (auth_date) may be. The redirect flow posts it right after the user
# authorises, so 10 minutes is plenty.
TELEGRAM_LOGIN_MAX_AGE_SECONDS=600

# --- Client IP behind the web proxy (rate limits) ---
# Comma-separated IPs/CIDRs of the ONLY peer allowed to set X-Forwarded-For: the web app's proxy.
# uvicorn reads this variable itself (--proxy-headers) and takes the right-most untrusted entry as
# the client. Required in staging and production ('*' rejected there); left unset locally,
# uvicorn trusts loopback only.
# FORWARDED_ALLOW_IPS=10.0.0.2

# --- Logging (app/core/logging.py) ---
# json (default; required in staging/production) | text (local terminal only).
LOG_FORMAT=text
LOG_LEVEL=INFO
# Immutable release id (image tag / git SHA); the image sets it at build time.
# APP_RELEASE=

# --- Database pool and server-side guards (per process) ---
# Staging/production: DATABASE_URL must end with ?ssl=verify-full (asyncpg's parameter, not sslmode)
# and REDIS_URL must be rediss://. instances x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + the migration
# job must stay below the database's connection limit (infra/neon/README.md).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# --- One-off migration job only (never set on the API itself) ---
# The migration role's URL. When unset, Alembic uses DATABASE_URL (local development).
# MIGRATION_DATABASE_URL=

# --- Neon (filled from the repo-root .env.local by `uv run python -m app.dev.neon_env`) ---
# `neon deploy` writes Neon's own names to <repo>/.env.local; the mapper rewrites DATABASE_URL to
# postgresql+asyncpg://...?ssl=verify-full on the direct endpoint. Set PGSSLROOTCERT to your CA
# bundle locally (the image sets it).
# S3-compatible object storage for product images (Neon Object Storage or R2). All four or none.
# OBJECT_STORAGE_BUCKET=assets
# OBJECT_STORAGE_ENDPOINT_URL=
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Neon Auth (Managed Better Auth): enables GET /api/v1/auth/neon/me. Both or neither.
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
