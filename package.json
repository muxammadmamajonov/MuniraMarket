{
  "name": "muniramarket",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "api:seed": "make -C services/api seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:generate": "make -C services/api openapi && pnpm --filter @muniramarket/contracts generate"
  },
  "devDependencies": {
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "prettier": "3.9.10"
  }
}
